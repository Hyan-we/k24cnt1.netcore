@model NhaLesson10EFDbFirst.Models.NhaMember

@{
    ViewData["Title"] = "Create - Them moi thanh vien";
}

<h1>Create</h1>

<h4>NhaMember</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="NhaUserName" class="control-label"></label>
                <input asp-for="NhaUserName" class="form-control" />
                <span asp-validation-for="NhaUserName" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="NhaPassword" class="control-label"></label>
                <input asp-for="NhaPassword" type="password" class="form-control" />
                <span asp-validation-for="NhaPassword" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="NhaFullName" class="control-label"></label>
                <input asp-for="NhaFullName" class="form-control" />
                <span asp-validation-for="NhaFullName" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="NhaEmail" class="control-label"></label>
                <input asp-for="NhaEmail" class="form-control" />
                <span asp-validation-for="NhaEmail" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="NhaPhone" class="control-label"></label>
                <input asp-for="NhaPhone" class="form-control" />
                <span asp-validation-for="NhaPhone" class="text-danger"></span>
            </div>
            <div class="form-group mb-3 form-check">
                <input asp-for="NhaStatus" class="form-check-input" type="checkbox" />
                <label asp-for="NhaStatus" class="form-check-label"></label>
                <span asp-validation-for="NhaStatus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

