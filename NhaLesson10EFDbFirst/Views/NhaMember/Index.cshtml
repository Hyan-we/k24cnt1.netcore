@model IEnumerable<NhaLesson10EFDbFirst.Models.NhaMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NhaUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NhaPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NhaFullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NhaEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NhaPhone)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NhaStatus)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.NhaUserName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NhaPassword)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NhaFullName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NhaEmail)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NhaPhone)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NhaStatus)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
