@model IEnumerable<NguyenHuyAnh_2410900003_exam.Models.NhaStudent>

@{
    ViewData["Title"] = "Danh Sach Sinh Vien - NhaStudent";
}

<div class="container-fluid py-4 px-lg-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">
                <i class="bi bi-people-fill text-primary me-2"></i>Quan Ly Sinh Vien
            </h2>
            <p class="text-muted mb-0 small">
                Danh sach sinh vien trong he thong
            </p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm fw-semibold">
                <i class="bi bi-person-plus-fill me-2"></i>Them Moi Sinh Vien
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-primary text-white p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-white-50 small text-uppercase fw-semibold">Tong sinh vien</div>
                        <div class="fs-2 fw-bold">@ViewBag.TotalStudents</div>
                    </div>
                    <div class="bg-white bg-opacity-25 rounded-circle p-3">
                        <i class="bi bi-people fs-2 text-white"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-success text-white p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-white-50 small text-uppercase fw-semibold">Dang hoat dong</div>
                        <div class="fs-2 fw-bold">@ViewBag.ActiveStudents</div>
                    </div>
                    <div class="bg-white bg-opacity-25 rounded-circle p-3">
                        <i class="bi bi-person-check fs-2 text-white"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-secondary text-white p-3">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-white-50 small text-uppercase fw-semibold">Tam khoa / Nghi</div>
                        <div class="fs-2 fw-bold">@ViewBag.InactiveStudents</div>
                    </div>
                    <div class="bg-white bg-opacity-25 rounded-circle p-3">
                        <i class="bi bi-person-x fs-2 text-white"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control bg-light border-start-0" placeholder="Tim theo ten, email, SDT hoac ID..." />
                    </div>
                </div>

                <div class="col-md-4">
                    <select name="statusFilter" class="form-select bg-light">
                        <option value="">-- Tat ca trang thai --</option>
                        <option value="active" selected="@(ViewBag.CurrentStatus == "active")">Dang hoat dong</option>
                        <option value="inactive" selected="@(ViewBag.CurrentStatus == "inactive")">Tam khoa / Ngung hoc</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-outline-primary flex-fill rounded-pill">
                        <i class="bi bi-funnel me-1"></i>Loc
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill" title="Lam moi">
                        <i class="bi bi-arrow-clockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 80px;">ID</th>
                        <th>Ho va ten</th>
                        <th>Gioi tinh</th>
                        <th>Ngay sinh</th>
                        <th>Email</th>
                        <th>So dien thoai</th>
                        <th>Trang thai</th>
                        <th class="text-center pe-4" style="width: 210px;">Thao tac</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-muted">
                                    #@item.Id
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle @(item.NhaGender ? "bg-primary-subtle text-primary" : "bg-danger-subtle text-danger") d-flex align-items-center justify-content-center me-3 fw-bold shadow-sm" style="width: 40px; height: 40px; font-size: 1rem;">
                                            @(string.IsNullOrWhiteSpace(item.NhaName) ? "?" : item.NhaName.Trim().Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@item.NhaName</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @if (item.NhaGender)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-gender-male me-1"></i>Nam
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-gender-female me-1"></i>Nu
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="fw-semibold">
                                        <i class="bi bi-calendar3 me-1 text-muted"></i>@item.NhaBirthDay.ToString("dd/MM/yyyy")
                                    </span>
                                </td>
                                <td>
                                    <a href="mailto:@item.NhaEmail" class="text-decoration-none text-dark small">
                                        <i class="bi bi-envelope me-1 text-primary"></i>@item.NhaEmail
                                    </a>
                                </td>
                                <td>
                                    <a href="tel:@item.NhaPhone" class="text-decoration-none text-dark small">
                                        <i class="bi bi-telephone me-1 text-success"></i>@item.NhaPhone
                                    </a>
                                </td>
                                <td>
                                    @if (item.NhaActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Hoat dong
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-pause-circle-fill me-1"></i>Tam khoa
                                        </span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="btn-group shadow-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Xem chi tiet">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Chinh sua">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Xoa sinh vien">
                                            <i class="bi bi-trash-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                <h6 class="fw-bold">Khong tim thay sinh vien nao</h6>
                                <p class="small mb-0">Thu thay doi tu khoa tim kiem hoac bam Them Moi Sinh Vien</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
