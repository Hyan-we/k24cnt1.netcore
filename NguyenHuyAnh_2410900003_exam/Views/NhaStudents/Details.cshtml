@model NguyenHuyAnh_2410900003_exam.Models.NhaStudent

@{
    ViewData["Title"] = "Chi Tiet Sinh Vien - " + Model.NhaName;
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb bg-light p-3 rounded-3 border">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none"><i class="bi bi-house-door-fill"></i> Trang chu</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Danh sach sinh vien</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiet: @Model.NhaName</li>
        </ol>
    </nav>

    <div class="row g-4 justify-content-center">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden text-center h-100">
                <div class="py-5 text-white position-relative @(Model.NhaGender ? "bg-primary bg-gradient" : "bg-danger bg-gradient")">
                    <div class="rounded-circle bg-white d-inline-flex align-items-center justify-content-center shadow-lg border border-3 border-white mb-3"
                         style="width: 100px; height: 100px; font-size: 2.5rem; font-weight: 700; color: @(Model.NhaGender ? "#0d6efd" : "#dc3545")">
                        @(Model.NhaName.Trim().Substring(0, 1).ToUpper())
                    </div>
                    <h5 class="fw-bold mb-1">@Model.NhaName</h5>
                    <span class="badge bg-white text-dark px-3 py-2 rounded-pill small shadow-sm">
                        ID: #@Model.Id
                    </span>
                </div>
                <div class="card-body p-3">
                    <div class="mb-3">
                        @if (Model.NhaGender)
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 me-1">
                                <i class="bi bi-gender-male me-1"></i>Nam
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2 me-1">
                                <i class="bi bi-gender-female me-1"></i>Nu
                            </span>
                        }
                        @if (Model.NhaActive)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
                                <i class="bi bi-check-circle-fill me-1"></i>Hoat dong
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-2">
                                <i class="bi bi-pause-circle-fill me-1"></i>Tam khoa
                            </span>
                        }
                    </div>

                    <div class="d-grid gap-2 px-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill fw-semibold">
                            <i class="bi bi-pencil-square me-1"></i>Chinh sua
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger rounded-pill">
                            <i class="bi bi-trash-fill me-1"></i>Xoa
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
                            <i class="bi bi-arrow-left me-1"></i>Quay lai danh sach
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="card-title mb-0 fw-bold text-info">
                        <i class="bi bi-card-text me-2"></i>Thong Tin Chi Tiet
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border d-flex align-items-center">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width:42px;height:42px;">
                                    <i class="bi bi-hash fs-5"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Ma so (ID)</small>
                                    <span class="fs-5 fw-bold text-primary">#@Model.Id</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border d-flex align-items-center">
                                <div class="rounded-circle bg-info text-white d-flex align-items-center justify-content-center me-3" style="width:42px;height:42px;">
                                    <i class="bi bi-person-fill fs-5"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Ho va ten</small>
                                    <span class="fs-6 fw-bold text-dark">@Model.NhaName</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border d-flex align-items-center">
                                <div class="rounded-circle @(Model.NhaGender ? "bg-primary" : "bg-danger") text-white d-flex align-items-center justify-content-center me-3" style="width:42px;height:42px;">
                                    <i class="bi @(Model.NhaGender ? "bi-gender-male" : "bi-gender-female") fs-5"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Gioi tinh</small>
                                    <span class="fs-6 fw-bold text-dark">@Model.GenderText</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border d-flex align-items-center">
                                <div class="rounded-circle bg-danger text-white d-flex align-items-center justify-content-center me-3" style="width:42px;height:42px;">
                                    <i class="bi bi-calendar-event-fill fs-5"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Ngay sinh</small>
                                    <span class="fs-6 fw-bold text-dark">@Model.NhaBirthDay.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border d-flex align-items-center">
                                <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center me-3" style="width:42px;height:42px;">
                                    <i class="bi bi-telephone-fill fs-5"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">So dien thoai</small>
                                    <a href="tel:@Model.NhaPhone" class="fs-6 fw-bold text-dark text-decoration-none">@Model.NhaPhone</a>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border d-flex align-items-center">
                                <div class="rounded-circle bg-warning text-white d-flex align-items-center justify-content-center me-3" style="width:42px;height:42px;">
                                    <i class="bi bi-envelope-fill fs-5"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Dia chi Email</small>
                                    <a href="mailto:@Model.NhaEmail" class="fs-6 fw-bold text-dark text-decoration-none">@Model.NhaEmail</a>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="p-3 @(Model.NhaActive ? "bg-success-subtle border-success" : "bg-secondary-subtle border-secondary") rounded-3 border d-flex align-items-center">
                                <div class="rounded-circle @(Model.NhaActive ? "bg-success" : "bg-secondary") text-white d-flex align-items-center justify-content-center me-3" style="width:42px;height:42px;">
                                    <i class="bi @(Model.NhaActive ? "bi-check-circle-fill" : "bi-pause-circle-fill") fs-5"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Trang thai</small>
                                    <span class="fs-6 fw-bold @(Model.NhaActive ? "text-success" : "text-secondary")">@Model.StatusText</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
